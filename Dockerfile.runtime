# Privileged but narrowly scoped server-game manager. The public Platform API never
# receives the Docker socket; only this internal service does.
FROM node:22-alpine
RUN apk add --no-cache docker-cli
WORKDIR /app
COPY runtime-service/server.js ./server.js
ENV NODE_ENV=production SERVER_GAME_RUNTIME_PORT=4100
EXPOSE 4100
CMD ["node", "server.js"]
