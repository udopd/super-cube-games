# Data API image: owns the PostgreSQL driver and the database access credentials.
FROM node:22-bookworm-slim
WORKDIR /app
COPY data-service/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY data-service/server.js ./data-service/server.js
COPY data-service/schema.sql ./data-service/schema.sql
COPY data-service/query-catalog.json ./data-service/query-catalog.json
COPY data-service/migrations/ ./data-service/migrations/
RUN chown -R node:node /app
USER node
ENV NODE_ENV=production
EXPOSE 4001
CMD ["node", "data-service/server.js"]
